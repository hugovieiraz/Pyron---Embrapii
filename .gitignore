.venv/
__pycache__/
*.pyc
.pytest_cache/
# Dados e resultados ficam fora do git (licenças e tamanho)
dados/
saida/

# Dados locais do aplicativo (inspeções salvas)
app/dados_app/

# Lançador compilado (lancador/construir.py gera de novo)
lancador/obj/
lancador/dist/

# Modelos treinados (pesos grandes; só o LEIA-ME entra)
modelos/*/

# Planejamento local do GSD (gerado da versão antiga do plano)
.planning/

# aplicativo de apresentação: perfil do Edge e registro
apresentacao/.janela/
apresentacao/registro.log
!apresentacao/dados/
apresentacao/.celular/

# Dumps e backups SQL
*.sql
exportacao_pyron.sql


# configuração pessoal do Claude Code (permissões desta máquina)
.claude/settings.local.json

# ambiente do servidor com placa NVIDIA (0.9, F4): separado do .venv de desenvolvimento
.venv-gpu/

# Pyron desktop (Tauri, F5): compilação e cópias feitas pelo build.rs
desktop/src-tauri/target/
desktop/src-tauri/gen/
desktop/src-tauri/icons/
desktop/abertura/gerado/
desktop/src-tauri/permissions/autogenerated/
