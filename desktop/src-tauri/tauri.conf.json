{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pyron",
  "version": "0.9.0",
  "identifier": "br.pyron.desktop",
  "build": {
    "frontendDist": "../abertura"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:",
      "capabilities": ["abertura"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
